---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, lines, pricesIncludeIVA } from '../data/shop';
import { isAvailable } from '../data/catalog';
import { type Lang, t as tr } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
const groups = (['family-reserve', 'silent-sunrise'] as const).map((id) => ({ id, items: products.filter((p) => p.line === id && isAvailable(p)) })).filter((g) => g.items.length > 0);
---
<Base lang={lang} title="" route="shop">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{t('shop.eyebrow')}</p>
      <h1>{t('shop.title')}</h1>
      <p class="lead">{t('shop.lead')}</p>
      <div class="badges">
        <span class="badge">{t('badge.ra')}</span>
        <span class="badge">{t('badge.origin')}</span>
      </div>
      <p class="note">{pricesIncludeIVA && lang === 'es' ? t('priceNote.iva') + ' ' : ''}{t('priceNote.placeholder')} <span class="tbc">{t('tbc')}</span></p>
      {groups.map(({ id, items }) => (
        <div class="group">
          <div class="group-head">
            <h2>{lines[id].name}</h2>
            <p>{lines[id].description[lang]}</p>
          </div>
          <div class="grid">
            {items.map((p) => <ProductCard product={p} lang={lang} />)}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .lead {
    font-size: 1.15rem;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .note {
    font-size: 0.92rem;
  }
  .group {
    margin-top: 3.5rem;
  }
  .group-head {
    border-top: 1px solid rgba(74, 89, 53, 0.25);
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 2rem 1.5rem;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1rem;
    }
  }
</style>
