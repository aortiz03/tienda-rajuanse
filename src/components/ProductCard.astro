---
import Price from './Price.astro';
import { type Product, lines, sizes } from '../data/shop';
import { fromPrice } from '../data/catalog';
import { type Lang, t as tr, url, asset } from '../i18n/ui';
interface Props { product: Product; lang: Lang }
const { product: p, lang } = Astro.props;
const t = tr(lang);
const first = fromPrice(p);
---
<article class="card">
  <a href={url(lang, 'product', p.slug)} class="img">
    <img src={asset(p.image)} alt={`${lines[p.line].name} ${p.name}`} width="1000" height="1000" loading="lazy" />
  </a>
  <div class="body">
    <p class="line">{lines[p.line].name}</p>
    <h3><a href={url(lang, 'product', p.slug)}>{p.line === 'silent-sunrise' ? p.roast[lang] : p.name}</a></h3>
    <p class="meta">{p.process[lang]} · {p.roast[lang]}</p>
    <p class="price-row"><Price nio={first.nio} usd={first.usd} prefix={t('shop.from')} /> <span class="size">/ {sizes[first.size].label}</span></p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }
  .img {
    display: block;
    background: var(--tan);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1;
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .card:hover .img img {
    transform: scale(1.03);
  }
  .body {
    padding-top: 1rem;
  }
  .line {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--rust);
    margin: 0 0 0.2rem;
  }
  h3 {
    margin: 0 0 0.2rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .meta {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
  }
  .price-row {
    margin: 0;
    font-weight: 500;
  }
  .size {
    opacity: 0.75;
    font-size: 0.9rem;
  }
</style>
