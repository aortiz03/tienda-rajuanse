---
// Sello "RAJUANSE ESTATES" alrededor de un grano de café (versión simplificada del logo).
interface Props { size?: number; class?: string }
const { size = 56, class: cls } = Astro.props;
const id = 'arc' + Math.random().toString(36).slice(2, 8);
---
<svg class={cls} width={size} height={size} viewBox="0 0 100 100" role="img" aria-label="RAJUANSE Estates">
  <circle cx="50" cy="50" r="49" fill="#4a5935" />
  <circle cx="50" cy="50" r="44" fill="none" stroke="#f5e8ce" stroke-width="0.8" />
  <circle cx="50" cy="50" r="28" fill="none" stroke="#f5e8ce" stroke-width="0.8" />
  <defs><path id={id} d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" /></defs>
  <text font-family="Georgia, serif" font-size="9.5" letter-spacing="3.2" fill="#f5e8ce">
    <textPath href={`#${id}`} startOffset="2%">RAJUANSE • ESTATES •</textPath>
  </text>
  <ellipse cx="50" cy="50" rx="11" ry="15" fill="none" stroke="#f5e8ce" stroke-width="1.6" />
  <path d="M50,35.5 C44,44 56,56 50,64.5" fill="none" stroke="#f5e8ce" stroke-width="1.6" />
</svg>
